---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import DiagramPlatform from '../components/DiagramPlatform.astro';
import CTABand from '../components/CTABand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Base
  title="33Mega | The Atom — fully supported media storage built on Ceph"
  description="The Atom is a turnkey file and object storage platform for the media industry: Ceph and standard Dell hardware, designed, monitored and supported 24×7 by 33Mega."
>
  <HeroSlider />

  <!-- Trust strip -->
  <section class="band tight white">
    <div class="section-inner grid-4">
      <div class="stat-chip">
        <span class="num">10,000+</span>
        <span class="label">Ceph deployments worldwide, including CERN</span>
      </div>
      <div class="stat-chip">
        <span class="num">24×7</span>
        <span class="label">Monitoring and support by storage engineers</span>
      </div>
      <div class="stat-chip">
        <span class="num">4-hour</span>
        <span class="label">Contractual software SLA, NBD hardware swap</span>
      </div>
      <div class="stat-chip">
        <span class="num">0</span>
        <span class="label">Proprietary formats, licences or locked exit doors</span>
      </div>
    </div>
  </section>

  <!-- Product intro -->
  <section class="band">
    <div class="section-inner grid-2">
      <div>
        <p class="eyebrow">The product</p>
        <h2>Meet <span class="kicker">The Atom</span>.</h2>
        <p class="lead">
          File and object storage for media workflows, delivered as a single, fully managed
          system — built on Ceph and standard Dell hardware, designed around your workflow and
          supported by one team.
        </p>
        <p>
          Enterprise storage has become expensive, complex and restrictive. The Atom is our
          answer: no proprietary hardware, no proprietary software licences, no forced refresh cycles —
          a supported product with the economics and openness of open source.
        </p>
        <div class="actions">
          <a class="button primary" href="/atom/">Explore the platform</a>
          <a class="button ghost" href="/atom/#support">What support means</a>
        </div>
      </div>
      <div class="pop-panel violet">
        <h3>Turnkey means turnkey</h3>
        <ul class="check-list">
          <li>Designed around your workflow — capacity from ~100 TB to multiple petabytes.</li>
          <li>Hardware validated, built and integrated by us; owned by you.</li>
          <li>24×7 monitoring — we usually see problems before you do.</li>
          <li>Upgrades planned, tested and performed by our engineers.</li>
          <li>The Custom Solution Management Interface makes servicing and monitoring the solution a breeze.</li>
          <li>One number to call. One team owns the outcome, end to end.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="band white" id="use-cases">
    <div class="section-inner">
      <div class="center">
        <p class="eyebrow">One platform, three ways in</p>
        <h2>File. Object. Block.</h2>
        <p class="lead">Same cluster, same team, standard protocols — pick the access your workflow speaks.</p>
      </div>
      <div class="grid-3" style="margin-top: 38px;">
        <div class="pop-panel cyan">
          <h3>File storage</h3>
          <p>High-performance shared file storage for editing, finishing and shared media workspaces — over SMB and NFS with full POSIX support, accelerated by NVMe.</p>
          <a class="button cyan" href="/atom/file/">File use cases</a>
        </div>
        <div class="pop-panel pink">
          <h3>Object storage</h3>
          <p>Standards-compliant S3 for archive, content libraries, MAM integration, cloud workflows and AI pipelines — millions of objects, open formats.</p>
          <a class="button primary" href="/atom/object/">Object use cases</a>
        </div>
        <div class="pop-panel gold">
          <h3>Block storage</h3>
          <p>Resilient block volumes for the systems around your content: virtualisation, databases and playout infrastructure on the same platform.</p>
          <a class="button" href="/atom/block/">Block use cases</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture (serious) -->
  <section class="band">
    <div class="section-inner">
      <p class="eyebrow">Under the hood</p>
      <h2>Reliable by architecture, not by promise.</h2>
      <p class="lead" style="max-width: 800px;">
        Data is stored in multiple copies or erasure-coded across the cluster. When a drive or
        server fails, The Atom rebuilds automatically and carries on. Hardware failure is an
        expected event, not an emergency.
      </p>
      <DiagramPlatform />
      <div class="mgmt-note">
        <h3>Custom Management Interface, makes handling Ceph a breeze.</h3>
        <p style="max-width: 800px; margin-bottom: 0;">
          Our custom management interface makes handling the Ceph cluster a breeze. Need to
          upgrade? Need to see where a hardware error lies? Need to profile performance?
          Everything is available at a touch of a button. Of course — you may never want to see
          any of this, leaving the cluster management to our engineers, or you may wish to hook
          event notifications into your monitoring systems. Everything is possible.
        </p>
      </div>
    </div>
  </section>

  <!-- Media focus + exit promise -->
  <section class="band white halftone">
    <div class="section-inner grid-2">
      <div class="pop-quote">
        <p style="margin: 0;">
          “We spent decades designing and supporting storage for broadcasters, post facilities,
          sports organisations and archives. The Atom expects large files, millions of objects
          and high-throughput editing — because those are the environments we came from.”
        </p>
        <p class="small" style="margin: 14px 0 0;">— Jonathan Morgan &amp; Peter Watling, founders</p>
      </div>
      <div>
        <p class="eyebrow">Built for media</p>
        <h2>By media people, for media people.</h2>
        <p>
          Editing, archive, content management, cloud integration and AI workloads run against
          the same platform, under one namespace. AI, backup and general enterprise workloads run
          well on The Atom; media is who it was built for.
        </p>
        <p>
          <strong>And if you ever leave us?</strong> Your hardware is yours. Your data sits in
          open formats, served over standard protocols. Off-boarding is documented, not
          discovered. <a href="/about/#leave">Read the exit promise →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Services teaser -->
  <section class="band">
    <div class="section-inner grid-2">
      <div>
        <p class="eyebrow">Beyond storage</p>
        <h2>AI Consultancy</h2>
        <p class="lead">
          The same senior team helps organisations put AI to work: strategy, agentic automation,
          digital transformation, technology review and fractional CTO support.
        </p>
        <a class="button cyan" href="/ai-consultancy/">See how we help</a>
      </div>
      <div class="pop-panel">
        <h3>Practical, not hype</h3>
        <p>
          The last thing a business needs is AI slop and more screen time. What it needs is
          trusted, often invisible technology that removes legwork so people can focus on the
          work that matters. That is the standard we hold our consultancy to — and our storage.
        </p>
      </div>
    </div>
  </section>

  <!-- News -->
  {posts.length > 0 && (
    <section class="band white">
      <div class="section-inner">
        <div class="news-head">
          <h2 class="mt-0">Latest news</h2>
          <a class="button ghost" href="/news/">All news</a>
        </div>
        <div class="grid-3">
          {posts.map((post) => (
            <a class="pop-panel news-card" href={`/news/${post.id}/`}>
              <p class="eyebrow light">{post.data.tag}</p>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <p class="small">{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABand />
</Base>

<style>
  .mgmt-note { margin-top: 36px; }
  .news-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }
  .news-card {
    display: block;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .news-card:hover {
    transform: translate(3px, 3px);
    box-shadow: 4px 4px 0 var(--ink);
  }
</style>
